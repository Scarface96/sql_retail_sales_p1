<?xml version='1.0'?>
<!-- Tony Mulunda brand palettes for Tableau.
     Copy into Documents/My Tableau Repository/Preferences.tps (if that file already has
     palettes, paste the three <color-palette> blocks inside its <preferences> element),
     then restart Tableau. They appear in every colour menu. -->
<workbook>
  <preferences>
    <color-palette name="Tony Mulunda - Categorical" type="regular">
      <color>#0D6A62</color>
      <color>#D48A00</color>
      <color>#43BBAC</color>
      <color>#C4553B</color>
      <color>#5B7FA6</color>
      <color>#8E6BB0</color>
      <color>#7FA36B</color>
      <color>#8FA39D</color>
      <color>#F3B73E</color>
      <color>#2E4A45</color>
    </color-palette>
    <color-palette name="Tony Mulunda - Teal Sequential" type="ordered-sequential">
      <color>#E3F2EF</color>
      <color>#A9DBD3</color>
      <color>#6FC2B6</color>
      <color>#3A9E92</color>
      <color>#0D6A62</color>
      <color>#08433E</color>
    </color-palette>
    <color-palette name="Tony Mulunda - Risk Diverging" type="ordered-diverging">
      <color>#0D6A62</color>
      <color>#6FC2B6</color>
      <color>#F3E9C8</color>
      <color>#E39A7E</color>
      <color>#C4553B</color>
    </color-palette>
  </preferences>
</workbook>
